; WiFi Network Diagnostics - Configuration File
; ==============================================
; Copy this file as "config.ini" and place it next to wifi_diag.exe.
; Command-line arguments always override these values.

[network]
; Target host for ping, tracert, and iperf
target = 10.216.65.91

; Number of ping packets
ping_count = 50

; Traceroute settings
tracert_max_hops = 15
tracert_timeout = 30

[iperf]
; iperf3 server address (leave empty to use the same as target)
; iperf_server = 192.168.1.100
iperf_port = 60998
iperf_duration = 10
; Protocol: tcp or udp
iperf_proto = tcp
; UDP target bandwidth (only used when iperf_proto = udp)
iperf_bandwidth = 100M
; Set to true to skip iperf3 test
no_iperf = false

[wifi]
; Number of WiFi scan rounds
wifi_scans = 5
; Set to true to skip WiFi scanning entirely
no_wifi = false
; Set to true to skip the disconnect/reconnect test
no_reconnect = false
